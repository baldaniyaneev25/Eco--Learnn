# Copy to .env and fill in. Never commit real secrets.

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/ecolearn
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@ecolearn.local
ADMIN_PASSWORD=

# Shared secret for GET /api/cron/sync (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Optional: extra approved source domains (comma separated) beyond config/approved-sources.ts.
# Add a domain only after reviewing its terms of use, licence and rate limits.
ALLOWED_SOURCE_DOMAINS=

# Optional: alerting for repeatedly failing integrations
ALERT_WEBHOOK_URL=
ALERT_FAILURE_THRESHOLD=3

# Optional: machine translation drafts (LibreTranslate-compatible API). Leave as "none"
# to have editors enter translations manually.
TRANSLATION_PROVIDER=none
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# Worker tick interval (seconds) for `npm run worker`
WORKER_TICK_SECONDS=60
