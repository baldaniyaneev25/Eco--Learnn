# Copy to .env.local (or .env) in this folder.
# URL of the EcoLearn web backend. Leave empty during development to use the
# computer running `npx expo start` on port 3000 (works for a phone on the same Wi-Fi).
# For real builds use your deployed HTTPS URL, e.g. https://ecolearn.example.com
EXPO_PUBLIC_API_URL=
